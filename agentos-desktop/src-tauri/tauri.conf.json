{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AgentOS",
  "version": "0.1.0",
  "identifier": "com.github.agentos.desktop",
  "build": {
    "frontendDist": "../../agentos-console/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../agentos-console && npm run dev",
    "beforeBuildCommand": "cd ../agentos-console && VITE_API_BASE_URL=${AGENTOS_DESKTOP_SERVER_URL:-https://agent.touch-ai.tech} npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AgentOS",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 20 },
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
